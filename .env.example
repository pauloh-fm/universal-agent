# Copy to .env and adjust. Every variable is optional; defaults run fully offline.
# Full reference: docs/configuration.md

# --- Model -------------------------------------------------------------------
# fake   = deterministic offline model (no API key, for tests and first run)
# openai = any OpenAI-compatible API (OpenAI, Ollama, vLLM, LiteLLM, OpenRouter, ...)
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=http://localhost:11434/v1   # e.g. Ollama; leave unset for api.openai.com
# LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# --- Runtime -----------------------------------------------------------------
AGENTS_DIR=agents
DATA_DIR=.data
MAX_STEPS=8
MAX_CONTEXT_MESSAGES=40
# JSON list of tool risk levels that need human approval: ["write"], ["read","write"] or []
REQUIRE_CONFIRMATION_FOR=["write"]

# --- Calendar (clinic-example) --------------------------------------------------
# local = appointments in DATA_DIR (offline). google = Google Calendar, see docs/integrations/google-calendar.md
CALENDAR_BACKEND=local
# GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
# Path to the service-account JSON key. Keep the file OUTSIDE the repository.
# GOOGLE_CREDENTIALS_FILE=/path/outside/repo/service-account.json

# --- HTTP API ----------------------------------------------------------------
# Set in any non-local deployment. Clients send: Authorization: Bearer <token>
# API_TOKEN=
LOG_LEVEL=INFO
